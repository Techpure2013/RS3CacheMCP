# cutscenes: the 2d cutscenes, a canvas and the elements that play on it. Times are seconds.

type cutscenes
index 66
layout groups

record {
  u8 version
  u16 width
  u16 height
  u16 unk
  list[u8]<{
    pstring name
    f32 start
    f32 end
    u8 _graphics
    list[_graphics]<{
      pstring sprite
      u16 height
      u16 width
      u16 unk
      u16 spriteId -> sprites
      list[u8]<{f32 time; f32 value}> opacity
      list[u8]<{f32 time; f32 value}> rotation
      list[u8]<{f32 time; f32 x; f32 y}> translation
      list[u8]<{f32 time; f32 x; f32 y}> scale
    }> graphics
    u8 _sound
    pstring sound if _sound!=0
    u8 _subtitle
    pstring subtitle if _subtitle!=0
    {u8 unk; u16 soundId; u8 _extra; {f32 start; f32 end} extra if _extra!=0} audio if _graphics==0
  }> elements
  bytes[rest] padding
}
